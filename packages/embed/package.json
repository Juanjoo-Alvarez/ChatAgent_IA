{
  "name": "@agichat/embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agichat-widget.js"
    }
  },
  "unpkg": "./dist/agichat-widget.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@agichat/react": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}

{
  "name": "agichat-widget-sdk",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint . --max-warnings 0",
    "release:prepare": "pnpm build && node scripts/prepare-release.mjs",
    "test": "pnpm --recursive --if-present run test",
    "test:coverage": "pnpm --recursive --if-present run test:coverage",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.69.0"
  }
}

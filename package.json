{
  "name": "agichat-widget-sdk",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "dev:demo": "pnpm --filter @agichat/demo dev",
    "dev:api": "pnpm --filter @agichat/api... build && pnpm --filter @agichat/api dev",
    "dev:mcp": "pnpm --filter @agichat/mcp-server... build && pnpm --filter @agichat/mcp-server dev",
    "eval:agent": "pnpm --filter @agichat/agent eval",
    "eval:agent:live": "pnpm --filter @agichat/agent... build && node scripts/eval-agent-live.mjs",
    "lint": "eslint . --max-warnings 0",
    "release:prepare": "pnpm build && node scripts/prepare-release.mjs stage && pnpm --filter \"./packages/*\" pack --recursive --pack-destination release-artifacts && node scripts/prepare-release.mjs checksum",
    "test": "pnpm --recursive --if-present run test",
    "test:coverage": "pnpm --recursive --if-present run test:coverage",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.69.0"
  }
}

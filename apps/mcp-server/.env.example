# Copia este archivo como .env (no se versiona) y completa los valores.

# Token de lectura de la API de TMDB (v4). Se obtiene en la configuración de
# la cuenta de TMDB, sección API. Nunca lo incluyas en el código ni en commits.
TMDB_READ_ACCESS_TOKEN=

# Idioma de títulos, sinopsis y géneros (opcional, por defecto es-MX).
TMDB_LANGUAGE=es-MX
# Tiempo máximo por consulta a TMDB en milisegundos (opcional, por defecto 8000).
TMDB_TIMEOUT_MS=

# Límite de solicitudes a TMDB: <cantidad>/<duración>[,<cantidad>/<duración>].
# Unidades: ms, s, m, h, d. Obligatorio; no hay valor por defecto. Defínelo
# según las condiciones vigentes de TMDB y la consigna del curso.
QUOTA_TMDB=

# Almacenamiento compartido de cuotas y caché: redis (varias réplicas) o
# memory (solo desarrollo con una réplica).
SHARED_STORE=redis
REDIS_URL=redis://localhost:6379

# Transporte MCP Streamable HTTP.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
# Hosts permitidos en la cabecera Host (opcional, protección DNS rebinding).
# Ejemplo: localhost:8001,127.0.0.1:8001
MCP_ALLOWED_HOSTS=

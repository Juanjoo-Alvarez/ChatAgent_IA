CHAT_HOST=127.0.0.1
CHAT_PORT=8000
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MCP_URL=http://127.0.0.1:8001/mcp
# ollama = modelo real; fixture = integración determinista, NO es un LLM.
AGENT_MODE=ollama
# mcp = servidor de Saúl; fixture = datos ficticios, solo con AGENT_MODE=fixture.
TOOLS_MODE=mcp
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# memory: una réplica local. Para varias réplicas usar redis en TODAS.
SESSION_STORE=memory
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_MS=1800000
TURN_TIMEOUT_MS=60000
MAX_CONNECTIONS=64
MAX_CONCURRENT_TURNS=4

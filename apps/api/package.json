{
  "name": "@agichat/api",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": { "@agichat/agent": "workspace:*", "@agichat/protocol": "workspace:*", "ioredis": "^6.0.0", "ws": "^8.21.3" },
  "devDependencies": { "@types/node": "^22.20.5", "@types/ws": "^8.18.1", "@vitest/coverage-v8": "^3.2.4", "typescript": "^5.8.3", "vitest": "^3.2.4" }
}

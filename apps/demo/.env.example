# Dirección pública del backend; nunca poner tokens o claves en variables VITE_*.
# El backend debe permitir el origen de la demo en CHAT_ALLOWED_ORIGINS.
VITE_CHAT_WEBSOCKET_URL=ws://127.0.0.1:8000/chat
# Debe superar TURN_TIMEOUT_MS de la API; margen de 5 s para recibir su error.
VITE_CHAT_RESPONSE_TIMEOUT_MS=185000
